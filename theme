title-text     : ""
terminal-left  : "0"
terminal-top   : "0"
terminal-width : "100%"
terminal-height: "100%"
terminal-border: "0"
desktop-image  : "background.png"

+ boot_menu {
    left                       = "15%"
    top                        = "20%"
    width                      = "70%"
    height                     = "60%"
    item_font                  = "@font@ bold"
    item_color                 = "@themecolor@"
    selected_item_color        = "@selectedfgcolor@"
    item_height                = "@fontsize@"
    item_spacing               = "@fontsize@ * 0.4"
    icon_width                 = "@iconsize@"
    icon_height                = "@iconsize@"
    item_icon_space            = "@fontsize@ * 0.4"
    selected_item_pixmap_style = "selected_*.png"
    item_padding               = "@fontsize@ * 0.4"
    item_align                 = "left"
    item_pixmap_style          = "*.png"
}

+ label {
    left  = "0"
    top   = "100"
    width = "100%"
    align = "center"
    color = "@themecolor@"
    font  = "@font@ bold"
    text  = "ROBCO INDUSTRIES UNIFIED OPERATING SYSTEM"
}

+ label {
    left  = "0"
    top   = "140"
    width = "100%"
    align = "center"
    color = "@themecolor@"
    font  = "@font@ bold"
    text  = "COPYRIGHT 2075-2077 ROBCO INDUSTRIES"
}

+ label {
    left  = "0"
    top   = "180"
    width = "100%"
    align = "center"
    color = "@themecolor@"
    font  = "@font@ bold"
    text  = "-Server 1-"
}

+ label {
    id    = "__timeout__"
    left  = "0"
    top   = "98%-120"
    width = "100%"
    align = "center"
    color = "@themecolor@"
    font  = "@font@ bold"
    text  = "Booting selected entry in %02ds..."
}

+ label {
    left  = "0"
    top   = "98%-70"
    width = "100%"
    align = "center"
    color = "@themecolor@"
    font  = "@font@ bold"
    text  = "↑↓: select, 'c': command-line, 'e': edit"
}

+ progress_bar {
    left   = "15%"
    top    = "98%-30"
    width  = "70%"
    height = "@fontsize@"
    fg_color = "@themecolor@"
    bg_color = "#000000"
}
